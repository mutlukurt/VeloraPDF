{
  "name": "velora-pdf-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:apk": "npm install && npx expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "copy:apk": "mkdir -p /Users/mutlu/Desktop && cp android/app/build/outputs/apk/release/app-arm64-v8a-release.apk /Users/mutlu/Desktop/Velora-PDF-Mobile-1.0.0-arm64.apk",
    "ios": "expo run:ios",
    "postinstall": "node scripts/patch-expo-constants.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.11",
    "expo-asset": "~11.1.7",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.10",
    "expo-keep-awake": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-navigation-bar": "~4.2.4",
    "expo-print": "~14.1.4",
    "expo-router": "~5.1.0",
    "expo-screen-orientation": "~8.1.7",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "lucide-react-native": "^0.511.0",
    "react": "19.0.0",
    "react-native": "0.79.3",
    "react-native-blob-util": "^0.22.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-pdf": "^6.7.7",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
